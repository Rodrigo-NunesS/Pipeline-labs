algoritmo "Exercício Lan House"
// Função :
// Autor :
// Data : 12/01/2022
// Seção de Declarações 
var

   minutos, totalAPagar : real
   

inicio

      Escreval("Digite a quantidade em minutos utilizada pelo cliente: ")
      leia(minutos)
      
      totalAPagar <- minutos * ((1/60)*2)
      
      Escreval("Total a pagar: ", totalAPagar, " reais.")

fimalgoritmo
